# 실제 값은 .env(커밋 금지)에 넣거나 셸에서 export 한다.
# 01 대본 생성
ANTHROPIC_API_KEY=
# 02 TTS 백엔드: clova (기본, 키 필요) | edge (키 없음, 무료)
TTS_PROVIDER=clova
# clova — 네이버 클라우드 플랫폼 > AI·NAVER API > CLOVA Voice
NCP_CLOVA_CLIENT_ID=
NCP_CLOVA_CLIENT_SECRET=
CLOVA_SPEAKER=nara
# edge — 선택: 음성/속도 (기본 ko-KR-SunHiNeural, -15% = 0.85배속)
EDGE_VOICE=
EDGE_RATE=
# 04 배경 소재: 로컬(assets/backgrounds/) 우선. Pexels 는 기본 꺼짐.
USE_PEXELS=false
PEXELS_API_KEY=
